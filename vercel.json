{
    "version": 2,
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/api/optimize",
            "destination": "/api/optimize.js"
        },
        {
            "source": "/login",
            "destination": "/login.html"
        },
        {
            "source": "/dashboard",
            "destination": "/dashboard.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        }
    ]
}